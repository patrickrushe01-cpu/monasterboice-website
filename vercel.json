{
  "redirects": [
    {
      "source": "/support-the-parish",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/support-the-parish/",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/contact-us/",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/parish-bulletin",
      "destination": "/bulletins",
      "permanent": true
    },
    {
      "source": "/parish-bulletin/",
      "destination": "/bulletins",
      "permanent": true
    },
    {
      "source": "/latest-news",
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/latest-news/",
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/welcome",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/welcome/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/webcam-for-church-of-the-immaculate-conception-tenure",
      "destination": "/webcam",
      "permanent": true
    },
    {
      "source": "/webcam-for-church-of-the-immaculate-conception-tenure/",
      "destination": "/webcam",
      "permanent": true
    },
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug",
      "destination": "/news/:slug",
      "permanent": true
    },
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug/",
      "destination": "/news/:slug",
      "permanent": true
    },
    {
      "source": "/resources/",
      "destination": "/resources",
      "permanent": true
    },
    {
      "source": "/wp-content/:path*",
      "destination": "https://monasterboiceparishchurch.wordpress.com/wp-content/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}